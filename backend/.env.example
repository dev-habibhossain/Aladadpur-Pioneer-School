# Backend Environment Configuration Template

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/spik_sms

# Security Secrets
JWT_SECRET=your_jwt_access_secret_key_change_in_production
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_change_in_production

# CORS Client Origin
CLIENT_URL=http://localhost:5173

# Optional Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Mail (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
